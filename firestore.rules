rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return signedIn() && myRole() == 'admin'; }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // User baru hanya boleh membuat profil dirinya dengan role 'guest'
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == 'guest';
      // Role TIDAK boleh diubah oleh user; hanya admin
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- info guild (halaman Home) ----------
    match /guild/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- daftar anggota ----------
    match /members/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- pendaftar (dari form register) ----------
    match /applications/{id} {
      // Pendaftar hanya boleh membuat pendaftaran atas namanya sendiri
      // dengan status awal 'verifikasi' (tidak bisa langsung 'diterima')
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'verifikasi';
      // pendaftar hanya bisa lihat miliknya, admin lihat semua
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      // hanya admin yang boleh mengubah status
      allow update, delete: if isAdmin();
    }

    // ---------- pesan / notifikasi ----------
    match /messages/{id} {
      // penerima membaca pesan miliknya; admin membaca semua
      allow read: if signedIn() && (resource.data.toUid == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      // penerima boleh menandai dibaca (hanya field 'read')
      allow update: if signedIn()
                    && resource.data.toUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }
  }
}
